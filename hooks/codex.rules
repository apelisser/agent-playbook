# Applied to escalation requests; sandbox and approval policy remain authoritative.
prefix_rule(
    pattern = ["rm", ["-r", "-R", "-rf", "-fr", "-rF", "-Rf"]],
    decision = "prompt",
    justification = "Confirm the target and scope before recursive deletion.",
    match = ["rm -rf build", "rm -r old-data"],
    not_match = ["rm temporary-file"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "Confirm which worktree changes will be discarded.",
    match = ["git reset --hard HEAD~1"],
)

prefix_rule(
    pattern = ["git", "clean", ["-f", "-fd", "-df", "-fx", "-xf", "-fdx", "-dxf", "--force"]],
    decision = "prompt",
    justification = "Preview untracked files with git clean -n before deletion.",
    match = ["git clean -fd", "git clean --force -d"],
    not_match = ["git clean -n"],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Confirm the destination and branch before publishing.",
    match = ["git push origin main", "git push --force origin feature"],
)

prefix_rule(
    pattern = ["terraform", ["apply", "destroy"]],
    decision = "prompt",
    justification = "Review the plan and target environment before changing infrastructure.",
    match = ["terraform apply", "terraform destroy"],
)

prefix_rule(
    pattern = ["kubectl", "delete"],
    decision = "prompt",
    justification = "Confirm the Kubernetes context, namespace, and resource.",
    match = ["kubectl delete pod example"],
)
